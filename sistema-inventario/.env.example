# =====================================================================
# Variables del entorno de contenedores (compose.yaml).
#   cp .env.example .env      y ajusta los valores en .env
# .env NO se sube a Git (tiene contraseñas). Si no existe, compose.yaml
# usa los mismos valores por defecto que aparecen aquí.
# =====================================================================

# --- Puertos publicados en tu máquina (y puerto interno de cada servicio) ---
PUERTO_FRONTEND=18200
PUERTO_GATEWAY=18090
PUERTO_EUREKA=18761
PUERTO_AUTH=18081
PUERTO_CATALOGOS=18082
PUERTO_INVENTARIO=18083
# PostgreSQL escucha en 5432 dentro de su contenedor; este es el puerto en tu máquina
PUERTO_POSTGRES=15432

# --- Base de datos ---
# Usuario y contraseña de PostgreSQL. Solo se aplican cuando se crea el volumen por primera vez.
DB_USER=inventario
DB_PASSWORD=inventario123

# --- Seguridad: el mismo secreto lo usan auth, catalogos e inventario (mínimo 32 caracteres) ---
JWT_SECRET=cambia-este-secreto-por-uno-largo-de-al-menos-32-caracteres

# --- Memoria de cada JVM ---
JAVA_OPTS="-Xms64m -Xmx384m -XX:+UseSerialGC"

# --- Versiones de las imágenes base (argumentos de construcción) ---
JAVA_VERSION=21
NODE_VERSION=24
POSTGRES_VERSION=17
